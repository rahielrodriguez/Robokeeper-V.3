SIGNAL_DELAY
	MOVLW	0X04	;Sets the delay time to generate the PW
	MOVWF	COUNTER2
TIMING_LOOP2
	MOVLW	VALUE_9K
	MOVWF	COUNTER1
TIMING_LOOP1
	DECFSZ	COUNTER1
	GOTO	TIMING_LOOP1
;	NOP
	DECFSZ	COUNTER2
	GOTO	TIMING_LOOP2
	MOVLW	0X00
	MOVWF	COUNTER2
	MOVLW	0X00
	MOVWF	COUNTER1
;	MOVLW	0X00
;	MOVWF	TIMING_REG
	RETURN
	
;SET LOW LOOP	
CALIBRATION_DELAY
	MOVLW	0X04	;Sets the delay time to generate the PS
	MOVWF	COUNTER2
CALIBRATION_TIMING_LOOP2
	MOVFW	TIMING_REG
	MOVWF	COUNTER1
CALIBRATION_TIMING_LOOP1
	DECFSZ	COUNTER1
	GOTO	CALIBRATION_TIMING_LOOP1
	DECFSZ	COUNTER2
	GOTO	CALIBRATION_TIMING_LOOP2
	MOVLW	0X00
	MOVWF	COUNTER2
	MOVLW	0X00
	MOVWF	COUNTER1
	RETURN
	
SENSOR_CHECK_DELAY	    ;Sensor Pulsing Delay Loop
	MOVLW	0X0F
	BANKSEL	COUNTER3
	MOVWF	COUNTER3
LOOP3_SENSOR
	MOVLW	0X0F
	MOVWF	COUNTER2
LOOP2_SENSOR
	MOVFW	TIMING_REG
	MOVWF	COUNTER1
LOOP1_SENSOR
	DECFSZ	COUNTER1
	GOTO	LOOP1_SENSOR
	DECFSZ	COUNTER2
	GOTO	LOOP2_SENSOR
	DECFSZ	COUNTER3
	GOTO	LOOP3_SENSOR
	RETURN
	
HOME_PULSE_DELAY	    ;Home Pulsing Timing Loop
	MOVLW	0x01
	BANKSEL	COUNTER3
	MOVWF	COUNTER3
LOOP3_HOME
	MOVLW	0X10
	MOVWF	COUNTER2
LOOP2_HOME
	MOVLW	0XA6
	MOVWF	COUNTER1
LOOP1_HOME
	DECFSZ	COUNTER1
	GOTO	LOOP1_HOME
	DECFSZ	COUNTER2
	GOTO	LOOP2_HOME
	DECFSZ	COUNTER3
	GOTO	LOOP3_HOME
	RETURN
	
