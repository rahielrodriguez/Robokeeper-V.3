	GOTO	LOAD_2K
	BTFSC	SPEED_REG1,1
	GOTO	LOAD_2.5K
	BTFSC	SPEED_REG1,2
	GOTO	LOAD_3K
	BTFSC	SPEED_REG1,3
	GOTO	LOAD_3.5K
	BTFSC	SPEED_REG1,4
