	BTFSC	SPEED_REG1,5
	GOTO	LOAD_4.5K
	BTFSC	SPEED_REG1,6
	GOTO	LOAD_5K
	BTFSC	SPEED_REG1,7
	GOTO	LOAD_5.5K
	BTFSC	SPEED_REG2,0
	GOTO	LOAD_6K
